{
  "name": "webdav-sync",
  "version": "1.0.0",
  "description": "基于 WebDAV 的多设备文件夹同步插件",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.preload.json --noEmit && vue-tsc && tsc -p tsconfig.node.json",
    "build": "vite build && npm run build:preload",
    "build:preload": "esbuild src-ztools/preload/services.mts --bundle --platform=node --format=cjs --target=node20 --sourcemap=linked --external:original-fs --outfile=src-ztools/preload/dist/services.js",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/shard",
    "test:fast": "vitest run --tagsFilter \"!slow\"",
    "test:slow": "vitest run --tagsFilter slow",
    "test:seq": "vitest run --no-file-parallelism",
    "test:e2e:built": "npm run build:preload && vitest run --config vitest.built.config.ts test/shard",
    "test": "vitest run && npm run build:preload && vitest run --config vitest.built.config.ts test/shard"
  },
  "dependencies": {
    "saxes": "^6.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "esbuild": "^0.28.2",
    "sass": "^1.105.0",
    "typescript": "^5.3.0",
    "unocss": "^66.10.5",
    "vite": "^6.0.11",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.0.0"
  }
}
